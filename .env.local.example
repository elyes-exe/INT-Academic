NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Configure Google Client ID and Secret in Supabase Auth > Providers > Google.
# Add http://localhost:3000/auth/google/callback to Supabase Auth > URL Configuration > Redirect URLs.
# Google Cloud's authorized redirect URI is the callback URL shown in the Supabase Google provider settings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=int_app
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=INT App <yourgmail@gmail.com>
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=INT App <onboarding@resend.dev>
