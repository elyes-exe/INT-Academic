{% extends 'base.html.twig' %}

{% block title %}Exams | INT App{% endblock %}

{% block body %}
    <section class="page-header split-header">
        <div>
            <p class="eyebrow">Exams</p>
            <h2>Examination management</h2>
            <p class="page-intro">Plan exam windows, assign classes, and keep classrooms visible to the administration.</p>
        </div>
        <a class="button button-primary" href="{{ path('exam_new') }}">Schedule exam</a>
    </section>

    <section class="stack-list">
        {% for exam in exams %}
            <article class="panel-card">
                <div class="announcement-header">
                    <div>
                        <div class="stack-item-title-row">
                            <h3>{{ exam.name }}</h3>
                            <span class="badge badge-status-{{ exam.status|lower }}">{{ exam.status }}</span>
                        </div>
                        <p class="stack-meta">{{ exam.className }}{% if exam.classroomName %} • {{ exam.classroomName }}{% endif %}</p>
                    </div>
                    <div class="card-actions">
                        <a class="button button-ghost" href="{{ path('exam_edit', {id: exam.id}) }}">Edit</a>
                        <form method="post" action="{{ path('exam_delete', {id: exam.id}) }}" onsubmit="return confirm('Delete this exam?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_exam_' ~ exam.id) }}">
                            <button class="button button-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </div>
                <p>{{ exam.startDate|date('d M Y') }}{% if exam.endDate|date('Y-m-d') != exam.startDate|date('Y-m-d') %} to {{ exam.endDate|date('d M Y') }}{% endif %}</p>
            </article>
        {% else %}
            <article class="panel-card empty-state">
                <p>No exam sessions have been configured yet.</p>
            </article>
        {% endfor %}
    </section>
{% endblock %}
