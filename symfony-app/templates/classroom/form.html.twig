{% extends 'base.html.twig' %}

{% block title %}{{ isEdit ? 'Edit classroom' : 'Add classroom' }} | INT App{% endblock %}

{% block body %}
    <section class="page-header split-header">
        <div>
            <p class="eyebrow">Classrooms</p>
            <h2>{{ isEdit ? 'Edit classroom' : 'Add classroom' }}</h2>
            <p class="page-intro">Capture capacity and occupancy data to avoid room conflicts and improve planning.</p>
        </div>
        <a class="button button-secondary" href="{{ path('classroom_index') }}">Back to list</a>
    </section>

    <section class="panel-card">
        {{ form_start(form, { attr: { class: 'panel-form' } }) }}
            <div class="form-grid">
                <div class="form-field">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="form-field">
                    {{ form_label(form.floor) }}
                    {{ form_widget(form.floor) }}
                    {{ form_errors(form.floor) }}
                </div>
                <div class="form-field">
                    {{ form_label(form.capacity) }}
                    {{ form_widget(form.capacity) }}
                    {{ form_errors(form.capacity) }}
                </div>
                <div class="form-field">
                    {{ form_label(form.currentUsage) }}
                    {{ form_widget(form.currentUsage) }}
                    {{ form_errors(form.currentUsage) }}
                </div>
                <div class="form-field">
                    {{ form_label(form.location) }}
                    {{ form_widget(form.location) }}
                    {{ form_errors(form.location) }}
                </div>
            </div>

            <div class="form-actions">
                <a class="button button-ghost" href="{{ path('classroom_index') }}">Cancel</a>
                <button class="button button-primary" type="submit">{{ isEdit ? 'Save changes' : 'Create classroom' }}</button>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
